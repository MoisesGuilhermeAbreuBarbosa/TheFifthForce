{
  "openapi": "3.1.0",
  "info": {
    "title": "OPEN FIELD public read API",
    "version": "3.1.0",
    "description": "Contributions use GitHub Issues and GitHub authentication. This site has no write API or account database."
  },
  "paths": {
    "/api/v1/research": {
      "get": {
        "responses": {
          "200": {
            "description": "Canonical research, references and links"
          }
        }
      }
    },
    "/api/v1/posts": {
      "get": {
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional kind or comma-separated kinds, including reference and paper."
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached GitHub Issues feed with next_before pagination"
          },
          "503": {
            "description": "GitHub unavailable; use repository directly"
          }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "summary": "Search the canonical versioned source library",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "All terms match source metadata"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact research field"
          },
          {
            "name": "evidence",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact evidence type"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "register, newest or oldest"
          }
        ],
        "responses": {
          "200": {
            "description": "Source records, total count and review-scope notice"
          }
        }
      }
    }
  }
}
