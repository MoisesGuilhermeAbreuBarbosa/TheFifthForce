{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFD hypothesis register v1",
  "type": "array",
  "minItems": 5,
  "maxItems": 5,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "kind",
      "statement",
      "chapter",
      "equation",
      "implementation",
      "version",
      "status",
      "date",
      "evidence_note",
      "assumptions",
      "predictions",
      "competitors",
      "falsification",
      "protocol",
      "acceptance",
      "sources",
      "atlas_subjects",
      "limitations",
      "parameters"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CFD-H[1-5]$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "minLength": 1
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "chapter": {
        "type": "string",
        "minLength": 1
      },
      "equation": {
        "type": "string",
        "minLength": 1
      },
      "implementation": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1,
        "const": "proposed_unreviewed"
      },
      "date": {
        "type": "string",
        "minLength": 1
      },
      "evidence_note": {
        "type": "string",
        "minLength": 1
      },
      "assumptions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "predictions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "competitors": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "falsification": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "protocol": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "acceptance": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "atlas_subjects": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "limitations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "parameters": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "name",
            "units",
            "domain"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "units": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
